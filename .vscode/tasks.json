{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-solution",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Pharmaceutical.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "build-webapi",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Pharmaceutical.WebAPI/Pharmaceutical.WebAPI.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-blazor",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/前端页面/Pharmaceutical.Blazor/Pharmaceutical.Blazor.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
