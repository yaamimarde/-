@page "/Error"
@using System.Diagnostics

<PageTitle>系统错误</PageTitle>

<div class="page-header">
    <h1>系统错误</h1>
    <p class="page-subtitle">处理请求时发生异常</p>
</div>

<div class="card">
    <div class="card-body">
        <p>抱歉，页面加载或操作失败。请尝试刷新或返回首页。</p>
        @if (ShowRequestId)
        {
            <p class="text-muted">请求 ID：<code>@RequestId</code></p>
        }
        <div class="quick-links" style="margin-top:1rem">
            <NavLink href="/" class="btn btn-primary btn-sm">返回首页</NavLink>
            <a href="." class="btn btn-secondary btn-sm">重新加载</a>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
