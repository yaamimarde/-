@page "/"
@implements IDisposable
@inject AuthStateService AuthState

<PageTitle>首页 - 药品管理综合系统</PageTitle>

<div class="page-header">
    <h1>药品管理综合系统</h1>
    <p class="page-subtitle">进销存 · 批次效期 · 智能预警 · 运营分析</p>
</div>

<div class="home-cards">
    <NavLink href="/dashboard" class="home-card">
        <div class="home-card-icon drugs">▣</div>
        <h3>运营仪表盘</h3>
        <p>库存估值、动销 Top10、智能补货建议与待审采购单概览。</p>
        <span class="home-card-link">查看仪表盘 →</span>
    </NavLink>

    <NavLink href="/drugs" class="home-card">
        <div class="home-card-icon drugs">☷</div>
        <h3>药品台账</h3>
        <p>录入、编辑、分页搜索与软下架；库存仅通过流水变更。</p>
        <span class="home-card-link">进入台账 →</span>
    </NavLink>

    <NavLink href="/alerts" class="home-card alert-card">
        <div class="home-card-icon alerts">!</div>
        <h3>库存预警</h3>
        <p>监控低库存药品，可一键生成采购单。</p>
        <span class="home-card-link">查看预警 →</span>
    </NavLink>

    <NavLink href="/expiry-alerts" class="home-card alert-card">
        <div class="home-card-icon alerts">⏱</div>
        <h3>效期预警</h3>
        <p>30/60/90 天临期批次监控，支撑 FEFO 出库策略。</p>
        <span class="home-card-link">查看效期 →</span>
    </NavLink>

    <NavLink href="/purchase-orders" class="home-card">
        <div class="home-card-icon drugs">📋</div>
        <h3>采购单</h3>
        <p>低库存 → 创建 PO → Admin 审核 → 收货入库。</p>
        <span class="home-card-link">管理采购 →</span>
    </NavLink>

    <NavLink href="/stock" class="home-card">
        <div class="home-card-icon alerts">↕</div>
        <h3>入库 / 出库</h3>
        <p>批次入库、FEFO 出库与流水查询导出。</p>
        <span class="home-card-link">库存操作 →</span>
    </NavLink>

    <NavLink href="/suppliers" class="home-card">
        <div class="home-card-icon drugs">◎</div>
        <h3>供应商管理</h3>
        <p>维护供应商信息，药品与采购单关联展示。</p>
        <span class="home-card-link">管理供应商 →</span>
    </NavLink>

    @if (AuthState.IsAdmin)
    {
        <NavLink href="/users" class="home-card">
            <div class="home-card-icon drugs">👤</div>
            <h3>用户管理</h3>
            <p>Admin 创建 Operator / Viewer 账号，完善 RBAC 闭环。</p>
            <span class="home-card-link">用户管理 →</span>
        </NavLink>

        <NavLink href="/audit-logs" class="home-card">
            <div class="home-card-icon drugs">📜</div>
            <h3>审计日志</h3>
            <p>查看药品、库存等变更的不可变审计记录。</p>
            <span class="home-card-link">审计日志 →</span>
        </NavLink>
    }
</div>

<div class="info-panel">
    <h4>业务流程</h4>
    <p class="workflow-line">低库存预警 → 生成采购单 → Admin 审核 → 收货入库（写批次+流水）→ FEFO 出库</p>
    <h4 style="margin-top:1rem">系统说明</h4>
    <ul>
        <li>WebAPI <code>http://localhost:5246</code> · Blazor <code>http://localhost:5100</code></li>
        <li>默认管理员 <code>admin</code> / <code>Admin@123</code></li>
        <li>角色：Admin（全部）、Operator（录入/出库/采购）、Viewer（只读）</li>
    </ul>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthState.AuthChanged += OnAuthChanged;
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => AuthState.AuthChanged -= OnAuthChanged;
}
