@page "/login"
@layout LoginLayout
@inject AuthApiService AuthApi
@inject NavigationManager Navigation

<PageTitle>登录 - 药品管理综合系统</PageTitle>

<div class="login-page">
    <div class="login-card">
        <h1>药品管理系统</h1>
        <p class="login-subtitle">请登录以继续操作</p>

        <AlertBanner Message="@_message" IsError="@_messageIsError" OnClose="ClearMessage" />

        <EditForm Model="_login" OnValidSubmit="HandleLogin">
            <div class="form-group">
                <label>用户名</label>
                <InputText @bind-Value="_login.Username" class="form-control" placeholder="admin" />
            </div>
            <div class="form-group">
                <label>密码</label>
                <InputText @bind-Value="_login.Password" type="password" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary btn-block" disabled="@_submitting">
                @(_submitting ? "登录中..." : "登录")
            </button>
        </EditForm>

        <p class="login-hint">默认管理员：admin / Admin@123</p>
    </div>
</div>

@code {
    private LoginDto _login = new();
    private string? _message;
    private bool _messageIsError;
    private bool _submitting;

    protected override void OnInitialized()
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query;
        if (query.Contains("expired=1", StringComparison.OrdinalIgnoreCase))
        {
            _message = "会话已失效，请重新登录";
            _messageIsError = true;
        }
    }
    private async Task HandleLogin()
    {
        _submitting = true;
        ClearMessage();
        StateHasChanged();

        try
        {
            var (success, msg) = await AuthApi.LoginAsync(_login.Username, _login.Password);
            if (success)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                _message = msg;
                _messageIsError = true;
            }
        }
        catch (Exception ex)
        {
            _message = $"无法连接 API：{ex.Message}";
            _messageIsError = true;
        }
        finally
        {
            _submitting = false;
        }
    }

    private void ClearMessage() => _message = null;
}
